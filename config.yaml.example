common:
  interval_time: 300

alist:
  base_url: https://example.com # 修改为你的alist访问地址
  token: alist-xxx # 修改为你的alist token；可在"管理员后台->设置->其他"中找到
  downloader: qBittorrent # 或者 aria2
  download_path: Onedrive/Anime # 修改为你的下载路径(Alist中的路径)

webdav:
  username: "admin" # WebDAV用户名
  password: "your_password" # WebDAV密码，请修改为您的实际密码
  timeout: 60 # WebDAV请求超时时间（秒），对于115云等慢响应服务建议设置为60-120秒
  fixer:
    enable: false # 是否启用WebDAV修复工具（需要设置为true才能使用）
    execute_mode: false # 是否实际执行修复操作（false=仅预览，true=实际执行）
    recursive_scan: true # 是否递归扫描子目录
    conflict_strategy: "skip" # 冲突处理策略: "skip"(跳过), "rename"(重命名), "overwrite"(覆盖)

mikan:
  subscribe_url:
    - https://mikanani.me/RSS/MyBangumi?token=xxx # 修改为你的蜜柑订阅地址
    # - https://mikanani.me/RSS/MyBangumi?token=xxx2 # 多条RSS订阅链接情况

  filters:
    - 非合集 # 程序暂不支持合集等形式的重命名，若使用重命名功能推荐使用此过滤器